# ==============================================================================
# TRAVELERP PLATFORM - Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# ==============================================================================

# ── Django Core ─────────────────────────────────────────────────────────────────
# Generate a strong secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-random-secret-key-here

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF
CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.dev

# ── Groq Cloud API (Rathasārathi AI Operations Copilot) ─────────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.8-27b

# ── PostgreSQL & PostGIS Database ───────────────────────────────────────────────
# Set USE_POSTGRES=0 to use SQLite (default for local development)
USE_POSTGRES=0
DATABASE_URL=postgres://travel_gis_user:travel_gis_pass@127.0.0.1:5434/travel_erp_gis

# ── Redis In-Memory Cache & Channel Layer ───────────────────────────────────────
# Leave empty or unset to use Django LocMemCache fallback
REDIS_URL=redis://127.0.0.1:6379/1

# ── WhatsApp Business API ───────────────────────────────────────────────────────
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_PHONE_NUMBER_ID=109876543210987
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_BUSINESS_PHONE=+91 94431 23456
FLEET_CONTROL_ROOM_PHONE=919876543210

# ── Email / SMTP Configuration ──────────────────────────────────────────────────
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ── Production SSL (only needed when deploying behind Nginx) ────────────────────
# SECURE_SSL_REDIRECT=True
