# Django Security
DEBUG=False
SECRET_KEY=generate-a-strong-64-character-random-hex-string-here
ALLOWED_HOSTS=erp.sivagayathiritravels.com,sivagayathiritravels.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://erp.sivagayathiritravels.com,https://sivagayathiritravels.com

# Database Connection (MySQL 8.0)
DATABASE_URL=mysql://travelerp_user:StrongPassword2026!@127.0.0.1:3306/travelerp
DB_NAME=travelerp
DB_USER=travelerp_user
DB_PASSWORD=StrongPassword2026!
DB_HOST=127.0.0.1
DB_PORT=3306

# Cache Tier (Redis 7)
REDIS_URL=redis://127.0.0.1:6379/1

# Meta WhatsApp Cloud API Credentials
WHATSAPP_API_TOKEN=EAAxxxxxx...
WHATSAPP_PHONE_NUMBER_ID=109283746501928
WHATSAPP_BUSINESS_PHONE=+919876543210
WHATSAPP_WEBHOOK_VERIFY_TOKEN=travelerp_secure_wa_webhook_token_2026

# Gunicorn Production Configuration
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=5
GUNICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker
GUNICORN_THREADS=4
GUNICORN_MAX_REQUESTS=1200
GUNICORN_MAX_REQUESTS_JITTER=100

