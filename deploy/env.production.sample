# ==============================================================================
# TravelERP (Siva Gayathri Tours & Travels) Production Environment Configuration
# Copy this file to .env.production and populate with secure production values
# ==============================================================================

# Core Django Security & Environment
DEBUG=False
SECRET_KEY=enter-a-strong-64-character-random-hex-string-for-production
ALLOWED_HOSTS=erp.sivagayathiritravels.com,sivagayathiritravels.com,localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=https://erp.sivagayathiritravels.com,https://sivagayathiritravels.com,https://localhost,https://127.0.0.1

# Database Configuration (PostgreSQL 15 + PostGIS 3.4 + pgvector 0.8.0)
USE_POSTGRES=1
PG_HOST=postgis
PG_PORT=5432
PG_DB=travel_erp_gis
PG_USER=travel_gis_user
PG_PASS=travel_gis_pass
DATABASE_URL=postgres://travel_gis_user:travel_gis_pass@postgis:5432/travel_erp_gis

# Cache & Channels Layer (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/1

# Rathasārathi AI Operations Copilot (Groq Cloud API)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Meta WhatsApp Cloud API Credentials
WHATSAPP_API_TOKEN=EAAxxxxxx...
WHATSAPP_PHONE_NUMBER_ID=109283746501928
WHATSAPP_BUSINESS_PHONE=+919876543210
WHATSAPP_WEBHOOK_VERIFY_TOKEN=travelerp_secure_wa_webhook_token_2026

# Gunicorn / Daphne ASGI Production Configuration
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=5
GUNICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker
GUNICORN_THREADS=4
GUNICORN_MAX_REQUESTS=1200
GUNICORN_MAX_REQUESTS_JITTER=100

# Automated Database Backup Configuration
BACKUP_CRON=0 2 * * *
BACKUP_ON_STARTUP=1
BACKUP_DIR=/backups

# Company Financials & Invoicing Defaults
COMPANY_UPI_VPA=sivagayathiritravels@icici
COMPANY_GSTIN=33AABCS1234F1Z8
DEFAULT_FROM_EMAIL=dispatch@sivagayathiritravels.com
